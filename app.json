{
  "expo": {
    "name": "FamilyCare Sync",
    "slug": "familycare-sync",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "familycare",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F6F4EF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.familycare.sync"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.familycare.sync",
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "themeColor": "#6B9E7A",
      "backgroundColor": "#F6F4EF",
      "name": "FamilyCare Sync",
      "shortName": "FamilyCare",
      "description": "Private family medical appointment coordination"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#6B9E7A"
        }
      ],
      "expo-location",
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      "expo-web-browser"
    ],
    "extra": {
      "firebaseApiKey": "",
      "firebaseAuthDomain": "",
      "firebaseProjectId": "",
      "firebaseStorageBucket": "",
      "firebaseMessagingSenderId": "",
      "firebaseAppId": ""
    }
  }
}
